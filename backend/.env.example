# Local library — filesystem buckets (required)
OFFLINE_EPUB_DIR=D:\Data\Book
# Text-only EPUB mirror (same filenames). Reader loads this first, then upgrades to full.
OFFLINE_EPUB_NOPICTURE_DIR=D:\Data\Book-nopicture
OFFLINE_IMPORT_DIR=D:\Data\Import
OFFLINE_IMG_DIR=D:\Data\Book-cover

# Cold storage — only needed for books with `drive` set in MongoDB.
# Preferred: auto-discover the Google Drive letter by a unique marker file placed
# inside each account's "My Drive" (drive letters aren't stable). Format:
#   email=<unique-marker-filename>   (file lives at <drive>:\My Drive\<marker>)
# OFFLINE_STORAGE_MARKERS=thienstream2411@gmail.com=projectd-coldstorage-xxxx.marker,idomusic2411@gmail.com=projectd-coldstorage-yyyy.marker
# Legacy manual override (skips discovery when set):
# OFFLINE_STORAGE_MOUNTS=thienstream2411@gmail.com=I:\My Drive,idomusic2411@gmail.com=G:\My Drive
# OFFLINE_HAKO_SUBDIR=Book
# OFFLINE_IMPORT_SUBDIR=Import

# Music (required for scan/stream/yt-dlp)
MUSIC_FOLDER=D:\Data\Music
IMG_FOLDER=D:\Data\Music-cover

# yt-dlp — cookie YouTube (tạm, tránh bot check). Đặt TRUE + đường dẫn file Netscape cookies.
# YTDLP_YOUTUBE_COOKIES=TRUE
# YTDLP_YOUTUBE_COOKIES_FILE=D:\Project C\Software\cookkies.txt

# Journal attachments (required)
JOURNAL_ATTACHMENT_DIR=D:\Data\journal-attachments

# AI Quota (required)
AI_QUOTA_ICON_DIR=D:\Data\ai-quota-icons

# Dashboard background images (optional; defaults to backend/data/dashboard-backgrounds)
# DASHBOARD_BG_DIR=D:\Data\dashboard-backgrounds

# MongoDB (optional — defaults shown)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=musicplayer
# LOCAL_LIBRARY_MONGODB_DB=Projectd_d3
# JOURNAL_MONGODB_DB=projectd_discord
# AI_QUOTA_MONGODB_DB=ai_quota
